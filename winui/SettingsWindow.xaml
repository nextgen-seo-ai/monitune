<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MonitorTune.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Заголовок окна и все подписи ставятся в конструкторе из
         Strings\<язык>\Resources.resw, поэтому в разметке текста нет. -->
    <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Padding="24,20,24,12">
            <TextBlock x:Name="HeaderText"
                       FontSize="20" FontWeight="SemiBold"/>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24,0,24,12" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">

                <!-- Шаг изменения -->
                <StackPanel Spacing="4">
                    <TextBlock x:Name="StepTitle"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StepHint"
                               FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                    <NumberBox x:Name="StepSizeBox"
                               Minimum="1" Maximum="50"
                               SmallChange="1" LargeChange="5"
                               SpinButtonPlacementMode="Inline"
                               MinWidth="200" HorizontalAlignment="Left"
                               ValueChanged="OnStepChanged"/>
                </StackPanel>

                <!-- Язык интерфейса -->
                <StackPanel Spacing="4">
                    <TextBlock x:Name="LanguageTitle"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LanguageHint"
                               FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ComboBox x:Name="LanguageBox"
                                  MinWidth="200" HorizontalAlignment="Left"
                                  SelectionChanged="OnLanguageChanged"/>
                        <TextBlock x:Name="LanguageStatus" VerticalAlignment="Center"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- Ночной режим -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="NightTitle" FontSize="15" FontWeight="SemiBold"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock x:Name="NightBrightnessLabel"
                                       Grid.Column="0" Grid.Row="0" VerticalAlignment="Center"/>
                            <NumberBox x:Name="NightBrightnessBox"
                                       Grid.Column="1" Grid.Row="0"
                                       Minimum="0" Maximum="100"
                                       SmallChange="1" LargeChange="5"
                                       SpinButtonPlacementMode="Inline"
                                       MinWidth="180"
                                       ValueChanged="OnNightValueChanged"/>

                            <TextBlock x:Name="NightContrastLabel"
                                       Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"/>
                            <NumberBox x:Name="NightContrastBox"
                                       Grid.Column="1" Grid.Row="1"
                                       Minimum="0" Maximum="100"
                                       SmallChange="1" LargeChange="5"
                                       SpinButtonPlacementMode="Inline"
                                       MinWidth="180"
                                       ValueChanged="OnNightValueChanged"/>

                            <ToggleSwitch x:Name="ScheduleSwitch"
                                          Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2"
                                          Toggled="OnScheduleToggled"/>

                            <Grid Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2"
                                  ColumnDefinitions="Auto,*,Auto,*"
                                  ColumnSpacing="8">
                                <TextBlock x:Name="FromLabel" VerticalAlignment="Center" Grid.Column="0"/>
                                <TimePicker x:Name="StartTimePicker"
                                            Grid.Column="1"
                                            ClockIdentifier="24HourClock"
                                            MinWidth="160"
                                            HorizontalAlignment="Stretch"
                                            SelectedTimeChanged="OnTimeChanged"/>
                                <TextBlock x:Name="ToLabel" VerticalAlignment="Center" Grid.Column="2" Margin="8,0,0,0"/>
                                <TimePicker x:Name="EndTimePicker"
                                            Grid.Column="3"
                                            ClockIdentifier="24HourClock"
                                            MinWidth="160"
                                            HorizontalAlignment="Stretch"
                                            SelectedTimeChanged="OnTimeChanged"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Активность и сон -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="AwakeTitle" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AwakeHint" TextWrapping="Wrap" FontSize="12" Opacity="0.7"/>

                        <ToggleSwitch x:Name="PreventSleepSwitch"
                                      Toggled="OnPreventSleepToggled"/>

                        <ToggleSwitch x:Name="SimulateActivitySwitch"
                                      Toggled="OnSimulateActivityToggled"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" x:Name="IntervalRow">
                            <TextBlock x:Name="IntervalLabel"
                                       Grid.Column="0" VerticalAlignment="Center"/>
                            <NumberBox x:Name="IntervalBox"
                                       Grid.Column="1"
                                       Minimum="5" Maximum="600"
                                       SmallChange="5" LargeChange="30"
                                       SpinButtonPlacementMode="Inline"
                                       MinWidth="180"
                                       ValueChanged="OnIntervalChanged"/>
                        </Grid>

                        <ToggleSwitch x:Name="VisibleMoveSwitch"
                                      Toggled="OnVisibleMoveToggled"/>
                        <TextBlock x:Name="VisibleMoveHint" TextWrapping="Wrap" FontSize="11" Opacity="0.6"/>
                    </StackPanel>
                </Border>

                <!-- Обновления и диагностика -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="UpdatesTitle" FontSize="15" FontWeight="SemiBold"/>

                        <ToggleSwitch x:Name="AutoUpdateSwitch"
                                      Toggled="OnAutoUpdateToggled"/>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="CheckUpdatesButton" Click="CheckUpdatesClick"/>
                            <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center"
                                       FontSize="12" Opacity="0.7"/>
                        </StackPanel>

                        <TextBlock x:Name="DiagnosticTitle"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <ToggleSwitch x:Name="TelemetrySwitch"
                                      Toggled="OnTelemetryToggled"/>
                        <TextBlock x:Name="TelemetryHint" TextWrapping="Wrap" FontSize="11" Opacity="0.6"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,12,24,18">
            <Button x:Name="CloseButton" Click="CloseClick"
                    HorizontalAlignment="Right" MinWidth="100"/>
        </Border>
    </Grid>
</Window>
