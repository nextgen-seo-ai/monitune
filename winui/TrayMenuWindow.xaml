<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MonitorTune.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Собственное окно вместо MenuFlyout. Flyout в режиме SecondWindow протухал и
         показывался обрезанным, а нативное меню Windows не умеет ни иконок, ни вида
         WinUI. Здесь размер считаем сами (FitToContent), поэтому обрезаться нечему. -->
    <Grid x:Name="RootGrid"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
          BorderThickness="1"
          CornerRadius="8"
          Padding="4">
        <Grid.Resources>
            <!-- Пункт меню: повторяет метрики MenuFlyoutItem, чтобы вид остался прежним. -->
            <Style x:Key="MenuItemStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="11,8,16,8"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="14"/>
                <!-- Меню открывают мышью, а фокус при показе встаёт на первый пункт и
                     рисует вокруг него рамку — она читается как артефакт. -->
                <Setter Property="UseSystemFocusVisuals" Value="False"/>
            </Style>
        </Grid.Resources>

        <StackPanel x:Name="ItemsHost" Spacing="0"/>
    </Grid>
</Window>
