<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MonitorTune.TrayIconHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <!-- Подписи пунктов проставляются в конструкторе из Strings\<язык>\Resources.resw,
         поэтому в разметке их нет: так пропавший ключ сразу виден, а не маскируется
         русским текстом из XAML. -->
    <!-- Контекстное меню не отдаём библиотеке: её flyout протухал и показывался
         обрезанным, а нативное меню теряет иконки и вид WinUI. По правому клику
         показываем собственное окно TrayMenuWindow. -->
    <tb:TaskbarIcon
        x:Name="Tray"
        NoLeftClickDelay="True"
        RightClickCommand="{x:Bind ShowMenuCmd}"
        LeftClickCommand="{x:Bind LeftClick}">
        <tb:TaskbarIcon.IconSource>
            <BitmapImage UriSource="ms-appx:///Assets/AppIcon.ico"/>
        </tb:TaskbarIcon.IconSource>
        <tb:TaskbarIcon.TrayToolTip>
            <Border CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    Padding="14,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Width="20" Height="20"
                           Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png"/>
                    <TextBlock x:Name="TrayToolTipText"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </tb:TaskbarIcon.TrayToolTip>
    </tb:TaskbarIcon>
</UserControl>
